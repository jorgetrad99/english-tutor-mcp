# One-shot `migrate` service only (migrations, then the database roles). Copy to
# deploy/migrate.env (chmod 600). Nothing here reaches the app container.
# Three database roles exist in production:
#   owner (POSTGRES_USER in db.env)   runs migrations; this file only
#   APP_DB_USER                       the app's LOGIN role: NOSUPERUSER NOBYPASSRLS, member of tutor_app
#   tutor_report                      read-only gate report (GATE_REPORT_DATABASE_URL, on demand)

# The postgres container's owner. Same user, password and database as db.env; host is `db`.
MIGRATION_DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
# Name of the app login role; a lowercase name that is not postgres, tutor_app or tutor_report,
# and not POSTGRES_USER. Goes into DATABASE_URL in tutor.env.
APP_DB_USER=tutor_login
# At least 32 characters each, different from each other and from POSTGRES_PASSWORD
# (openssl rand -hex 24). Rotating = edit, then rerun `migrate`.
APP_DB_PASSWORD=<openssl rand -hex 24>
REPORT_DB_PASSWORD=<openssl rand -hex 24>
