# Local run of the real app on your own machine. Copy to deploy/local.env (git-ignored) and replace
# every <placeholder>. Steps: docs/v0/local.md. Throwaway values, except the Google client (the
# spike client is reused); never reuse production or spike signing keys here. One file feeds
# migrations, role provisioning and the app (dev only: the
# production app env must never hold MIGRATION_DATABASE_URL, the server refuses it when prod).

# --- App ---------------------------------------------------------------------------------------
TUTOR_ENV=dev
# Default: the public tunnel hostname (second hostname on the spike's cloudflared tunnel), so
# claude.ai and the mobile app can reach this machine. https, no path, no trailing slash. The
# website answers only to this host (TrustedHost); open it by this hostname.
# Offline / Claude Code only alternative: TUTOR_BASE_URL=http://localhost:8000 and
# TUTOR_MCP_URL=http://localhost:8000/mcp (http is accepted only on loopback; use "localhost", not
# 127.0.0.1), and register the http://localhost:8000 redirect URIs in Google.
TUTOR_BASE_URL=https://tutor.develancoders.com
TUTOR_MCP_URL=https://tutor.develancoders.com/mcp
TUTOR_SUPPORT_EMAIL=soporte@example.com
TUTOR_PORT=8000
TUTOR_HOST=127.0.0.1
# cloudflared runs on this machine and connects from loopback; trust X-Forwarded-* only from there.
FORWARDED_ALLOW_IPS=127.0.0.1
TUTOR_OAUTH_STORAGE_DIR=data/oauth
# Leave empty (test login only works with TUTOR_ENV=test).
TUTOR_TEST_LOGIN=

# --- Secrets (generate, see docs/v0/local.md step 2; three distinct values) ----------------------
TUTOR_JWT_SIGNING_KEY=<at least 32 characters>
TUTOR_WEB_SESSION_SECRET=<at least 32 characters, different from the key above>
TUTOR_OAUTH_STORAGE_KEY=<fernet key>

# --- Google OAuth client (the spike's Web client, with the product redirect URIs added) ---
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>

# --- Database (compose service `db`, port 5432; never db-test on 5433) ---------------------------
# Owner (superuser) of the dev database: migrations and role provisioning only.
MIGRATION_DATABASE_URL=postgresql://tutor:tutor@localhost:5432/tutor
# The app's own LOGIN role, created by tutor.ops.provision_roles. Put the same password here:
APP_DB_USER=tutor_login
APP_DB_PASSWORD=<at least 32 characters>
REPORT_DB_PASSWORD=<at least 32 characters, different from APP_DB_PASSWORD>
DATABASE_URL=postgresql://tutor_login:<same as APP_DB_PASSWORD>@localhost:5432/tutor
# Optional, only for `just gate-report`: postgresql://tutor_report:<REPORT_DB_PASSWORD>@localhost:5432/tutor
# GATE_REPORT_DATABASE_URL=
