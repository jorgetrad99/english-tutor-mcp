# Local run of the real app on your own machine. Copy to deploy/local.env (git-ignored) and replace
# every <placeholder>. Steps: docs/v0/local.md. Throwaway values only: never reuse production or
# spike secrets here. One file feeds migrations, role provisioning and the app (dev only: the
# production app env must never hold MIGRATION_DATABASE_URL, the server refuses it when prod).

# --- App ---------------------------------------------------------------------------------------
TUTOR_ENV=dev
# http is accepted only on loopback. Use "localhost", not 127.0.0.1 (TrustedHost matches this host).
# For a Cloudflare tunnel (claude.ai / mobile) use the https tunnel URL instead, in all three.
TUTOR_BASE_URL=http://localhost:8000
TUTOR_MCP_URL=http://localhost:8000/mcp
TUTOR_SUPPORT_EMAIL=soporte@example.com
TUTOR_PORT=8000
TUTOR_HOST=127.0.0.1
TUTOR_OAUTH_STORAGE_DIR=data/oauth
# Leave empty (test login only works with TUTOR_ENV=test).
TUTOR_TEST_LOGIN=

# --- Secrets (generate, see docs/v0/local.md step 3; three distinct values) ----------------------
TUTOR_JWT_SIGNING_KEY=<at least 32 characters>
TUTOR_WEB_SESSION_SECRET=<at least 32 characters, different from the key above>
TUTOR_OAUTH_STORAGE_KEY=<fernet key>

# --- Google OAuth client (Web application, your own test project) -------------------------------
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>

# --- Database (compose service `db`, port 5432; never db-test on 5433) ---------------------------
# Owner (superuser) of the dev database: migrations and role provisioning only.
MIGRATION_DATABASE_URL=postgresql://tutor:tutor@localhost:5432/tutor
# The app's own LOGIN role, created by tutor.ops.provision_roles. Put the same password here:
APP_DB_USER=tutor_login
APP_DB_PASSWORD=<at least 32 characters>
REPORT_DB_PASSWORD=<at least 32 characters, different from APP_DB_PASSWORD>
DATABASE_URL=postgresql://tutor_login:<same as APP_DB_PASSWORD>@localhost:5432/tutor
# Optional, only for `just gate-report`: postgresql://tutor_report:<REPORT_DB_PASSWORD>@localhost:5432/tutor
# GATE_REPORT_DATABASE_URL=
