# Postgres container (version 16 or later is required). Copy to deploy/db.env (chmod 600).
# POSTGRES_USER is the migration owner and a superuser: only the migrate service and the backup
# script use it. The app and the gate report use their own roles (migrate.env).
POSTGRES_USER=tutor_owner
# At least 32 characters (openssl rand -hex 24). Also used inside MIGRATION_DATABASE_URL.
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=tutor
