# Dev compose profile only (root docker-compose.yml, `uv run just dev`; docs/v0/local.md, "Dev
# profile"). You never copy or edit this by hand: scripts/dev_env.py writes deploy/dev.env
# (git-ignored, mode 0600) from this file, replacing every KEY placeholder in angle brackets with
# a fresh random value. One file feeds migrate-dev (owner URL, role passwords) and app-dev (login
# URL); compose blanks MIGRATION_DATABASE_URL and REPORT_DB_PASSWORD for app-dev, so the running
# app never holds the owner URL or the report password, as in the production layout.
# TUTOR_DEV_AUTH is set by compose on the two services, not here: the file by itself enables
# nothing, and the server refuses the flag outside loopback dev anyway.
TUTOR_ENV=dev
TUTOR_BASE_URL=http://localhost:8000
# Empty: derived from TUTOR_BASE_URL plus /mcp.
TUTOR_MCP_URL=
TUTOR_SUPPORT_EMAIL=soporte@example.test
TUTOR_PORT=8000
# Unused under dev auth (no OAuth proxy, no store); a writable path inside the container anyway.
TUTOR_OAUTH_STORAGE_DIR=/tmp/oauth
TUTOR_TEST_LOGIN=
# Optional under dev auth: nothing calls Google, so both stay empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random per machine (a 64-character urlsafe token and a Fernet key); never committed.
TUTOR_JWT_SIGNING_KEY=<TUTOR_JWT_SIGNING_KEY>
TUTOR_OAUTH_STORAGE_KEY=<TUTOR_OAUTH_STORAGE_KEY>
# Template frames: a *.localhost name is a distinct origin that browsers resolve to loopback, on
# the same published port; the server routes it by Host to the template origin app.
TUTOR_TEMPLATE_ORIGIN=http://templates.localhost:8000
TUTOR_FRAME_TOKEN_KEY=<TUTOR_FRAME_TOKEN_KEY>
# migrate-dev: the owner of the dev database (compose service `db`), then the roles it creates.
MIGRATION_DATABASE_URL=postgresql://tutor:tutor@db:5432/tutor
APP_DB_USER=tutor_login
APP_DB_PASSWORD=<APP_DB_PASSWORD>
REPORT_DB_PASSWORD=<REPORT_DB_PASSWORD>
# app-dev and dev_seed: the app's LOGIN role, same password as APP_DB_PASSWORD.
DATABASE_URL=postgresql://tutor_login:<APP_DB_PASSWORD>@db:5432/tutor
