# App container of the local Docker stack (deploy/compose.local.yml). Copy to deploy/local-docker.env
# (git-ignored) and replace every <placeholder>. Steps: docs/v0/local.md. Throwaway secrets only;
# never reuse production or spike keys. The owner URL does NOT belong here (migrate env only).
TUTOR_ENV=dev
TUTOR_BASE_URL=https://tutor.develancoders.com
# Empty: derived as <TUTOR_BASE_URL>/mcp (if set, it must be exactly that).
TUTOR_MCP_URL=
TUTOR_SUPPORT_EMAIL=soporte@example.com
TUTOR_PORT=8000
TUTOR_HOST=0.0.0.0
# Published-port traffic reaches uvicorn from the gateway of the `edge` network (compose.local.yml
# pins it to 172.31.90.1). Only that address may set X-Forwarded-*. Never "*".
FORWARDED_ALLOW_IPS=172.31.90.1
TUTOR_OAUTH_STORAGE_DIR=/data/oauth
TUTOR_TEST_LOGIN=

# Two distinct secrets (docs/v0/local.md step 2).
TUTOR_JWT_SIGNING_KEY=<at least 32 characters>
TUTOR_OAUTH_STORAGE_KEY=<fernet key>

# The spike's Google Web client (with the product redirect URIs added).
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>

# The app's LOGIN role on service `db`: user and password = APP_DB_USER / APP_DB_PASSWORD of
# local-migrate.env.
DATABASE_URL=postgresql://tutor_login:<APP_DB_PASSWORD>@db:5432/tutor
