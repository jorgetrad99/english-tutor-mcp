# App service settings. Copy to deploy/tutor.env on the server (chmod 600) and replace every
# <placeholder>. No secret lives in the repository; secret placeholders are deliberately too short
# or malformed to start the server, so a forgotten one fails at startup instead of running.
# Runbook: docs/v0/runbook.md ("First deploy"). Do NOT add MIGRATION_DATABASE_URL here: the owner
# URL belongs to migrate.env only, and the app must never hold it.

# prod turns on the production checks (PostgreSQL URL, FORWARDED_ALLOW_IPS without "*").
TUTOR_ENV=prod
# Public origin from the Cloudflare Tunnel hostname: https, no path, no trailing slash. The website
# only answers to this host (TrustedHost).
TUTOR_BASE_URL=https://tutor.example.com
# The MCP endpoint learners paste into Claude. Optional: when empty it is <TUTOR_BASE_URL>/mcp;
# when set it must be exactly that, or the server refuses to start.
TUTOR_MCP_URL=https://tutor.example.com/mcp
# Address learners write to for support and deletion requests.
TUTOR_SUPPORT_EMAIL=soporte@example.com
# The app's own LOGIN role (APP_DB_USER / APP_DB_PASSWORD in migrate.env), never the owner:
# postgresql://<APP_DB_USER>:<APP_DB_PASSWORD>@db:5432/<POSTGRES_DB>
# Startup refuses a superuser, BYPASSRLS, table-owning or non-tutor_app login.
DATABASE_URL=postgresql://<APP_DB_USER>:<APP_DB_PASSWORD>@db:5432/tutor
# Google OAuth client (Web application). Both redirect URIs are registered, see the runbook:
# <base>/oauth/callback (MCP) and <base>/auth/callback (website login).
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
# At least 32 characters (openssl rand -base64 48). Rotating it disconnects every Claude client.
TUTOR_JWT_SIGNING_KEY=<openssl rand -base64 48>
# A Fernet key encrypting the OAuth store (see the runbook for the command). Must differ from
# TUTOR_JWT_SIGNING_KEY. Rotating it makes old store entries unreadable; clients re-register.
TUTOR_OAUTH_STORAGE_KEY=<fernet key>
# Directory of the OAuth store: the named volume `oauth`, owned by the image's uid 10001.
TUTOR_OAUTH_STORAGE_DIR=/data/oauth
# Port and bind address inside the container; nothing is published on the host.
TUTOR_PORT=8000
TUTOR_HOST=0.0.0.0
# Addresses allowed to set X-Forwarded-* (uvicorn). Exactly the cloudflared container's fixed
# address on the compose network (compose.prod.yml). Never "*" (the server refuses it in prod).
FORWARDED_ALLOW_IPS=172.30.10.3
# Test-only login bypass. Leave empty: it is refused unless TUTOR_ENV=test on a loopback URL.
TUTOR_TEST_LOGIN=
